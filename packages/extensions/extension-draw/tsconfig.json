{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@speed-board/core": ["../../core/src"],
      "@speed-board/core/*": ["../../core/src/*"],
      "@speed-board/shared": ["../../shared/src"],
      "@speed-board/shared/*": ["../../shared/src/*"]
    }
  },
  "include": ["src/**/*"]
}
